# Copy this file to `keystore.properties` (which is git-ignored) and fill in your values
# to build signed release APKs locally. Not needed for debug builds, and not needed in CI -
# the release workflow supplies the same values via SIGNING_* secrets/environment variables
# instead of this file.

storeFile=/absolute/path/to/locker-release.jks
storePassword=
keyAlias=locker
keyPassword=
